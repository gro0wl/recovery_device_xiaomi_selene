# fstab
system                                     /system          ext4                ro wait,slotselect,logical
vendor                                     /vendor          ext4                ro wait,slotselect,logical
product                                    /product         ext4                ro wait,slotselect,logical

/dev/block/platform/bootdevice/by-name/md_udc       /metadata        ext4                noatime,nosuid,nodev,discard wait,check
/dev/block/platform/bootdevice/by-name/rescue       /cache           ext4                noatime,nosuid,nodev,noauto_da_alloc,discard wait,check

/dev/block/platform/bootdevice/by-name/userdata     /data            f2fs                noatime,nosuid,nodev,discard,noflush_merge,reserve_root=134217,resgid=1065,checkpoint_merge,fsync_mode=nobarrier wait,check,quota,latemount,resize,reservedsize=128m,checkpoint=fs

/dev/block/platform/bootdevice/by-name/misc         /misc            emmc                defaults       defaults

/dev/block/platform/bootdevice/by-name/boot         /boot            emmc                defaults       slotselect
